{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "teslam-genesis-api",
  "main": "worker.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],

  // Production serves only from the custom domain. A workers.dev URL would be
  // a second origin holding the same personal data, with none of the DNS or
  // CORS assumptions the site makes about itself.
  "workers_dev": false,
  "routes": [{ "pattern": "api.teslam.io", "custom_domain": true }],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true }
  },

  "vars": {
    "ALLOWED_ORIGINS": "https://teslam.io",
    "SITE_ORIGIN": "https://teslam.io",

    // Open since 2026-08-17, the same change that made mail live: the
    // confirmation sender is the Gmail API path (GMAIL_* secrets), from
    // noreply@teslam.io on the verified teslam.io secondary domain, with
    // SPF/DKIM/DMARC published. While mail could not leave the account this
    // was "false" on purpose — an open form in that state takes an address
    // and promises a link that never arrives. Keep the two in step: if the
    // mail path ever goes down, close this in the same change.
    "REGISTRATION_OPEN": "true",

    // Coordinates arrive in the same record as the odometer and are dropped
    // before the write unless this says otherwise. It stays "false" until two
    // things are true: the 위치정보법 filing is made, and the privacy policy
    // stops telling readers that location is not received at any stage.
    //
    // The code path is not deleted — cloudflare/lib/ingest.ts writes
    // reading_locations and the suite exercises it — so switching collection on
    // is a change to this line rather than a first run in production.
    "COLLECT_LOCATION": "false"
  },

  // TELEMETRY_TOKEN is held by the consumer on the receiving host and by
  // nothing else. It is deliberately not EXPORT_TOKEN: that one reads the
  // registration table, addresses and all, and a compromise of a box shared
  // with eleven other domains should not also hand over the mailing list.

  // RESEND_API_KEY, GMAIL_*, MAIL_FROM, EXPORT_TOKEN and TELEMETRY_TOKEN are
  // secrets, set with `wrangler secret put`. They are absent here on purpose —
  // a key in a committed config is a leaked key.

  // Cloudflare Email Sending. No API key: the binding is the credential.
  // The account must have Email Sending enabled and teslam.io onboarded
  // (`wrangler email sending enable teslam.io`) before a send succeeds; until
  // then the Worker records the registration and reports mailSent: false
  // rather than pretending a link went out.
  // Daily sweep of unconfirmed registrations past their link's expiry, which
  // is what makes the confirmation mail's deletion promise true.
  "triggers": { "crons": ["17 3 * * *"] },

  "send_email": [{ "name": "EMAIL" }],

  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveBoard"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "teslam-genesis-production",
      "database_id": "6f26cbc9-83a4-4833-9418-3d84d31efcef",
      "migrations_dir": "migrations"
    }
  ],

  "env": {
    "preview": {
      "name": "teslam-genesis-api-preview",
      "workers_dev": true,
      "routes": [],
      "compatibility_flags": ["nodejs_compat"],
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:3000",
        "SITE_ORIGIN": "http://localhost:3000",
        // Open here on purpose. Preview is where the form is developed and the
        // tests run; closing it would mean the public path shipped to
        // production having only ever been exercised through its refusal.
        "REGISTRATION_OPEN": "true",
        // On here for the same reason. Preview holds no member's car, so the
        // only coordinates it can ever store are ones a developer published to
        // it on purpose.
        "COLLECT_LOCATION": "true"
      },
      // Named environments do not inherit bindings, so these are repeated
      // rather than omitted. A missing binding here fails at request time, not
      // at deploy time, which is the worst moment to find out.
      "send_email": [{ "name": "EMAIL" }],
      "durable_objects": {
        "bindings": [{ "name": "LIVE", "class_name": "LiveBoard" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveBoard"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "teslam-genesis-preview",
          "database_id": "f00a64d8-6659-43f4-bc51-56b8c381bb18",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
