# Copy this file to `.env.local` in the same directory and fill in the values.
#
# `.env.local` is gitignored by the root .gitignore's `.env*.local`. A bare
# `.env` is reserved for production secrets in this workspace and a hook
# refuses to write one, which is why this is not called that.
#
# Fill it in a text editor. Do not paste the values into a chat window: a
# secret that reaches a conversation history has been disclosed, and rotating
# it is the only remedy.

# ── Coinbase Developer Platform ──────────────────────────────────────────
#
# portal.cdp.coinbase.com/api-keys/secret → create a Secret API Key.
# Keep Ed25519 as the algorithm; ECDSA is only for the Coinbase App and
# Advanced Trade SDKs. Download the JSON before closing the dialog — both
# values below are inside it and it is not shown again.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Only needed if the faucet refuses to pay an address CDP does not hold, in
# which case `cdp-fund.mjs` falls back to funding a CDP account and forwarding
# — and forwarding means signing.
#
# portal.cdp.coinbase.com/wallets/non-custodial/security → Generate Wallet
# Secret. Shown exactly once.
CDP_WALLET_SECRET=

# ── The account this spike deploys from ──────────────────────────────────
#
# A throwaway key, holding testnet ETH and nothing else. `cdp-fund.mjs` funds
# it and `base-flow.mjs` deploys from it. Generate one with:
#
#     cd scripts/chain && node -e 'console.log(require("viem/accounts").generatePrivateKey())'
#
# From this directory, not the repository root: `viem` is installed here and
# `node -e` resolves modules against the working directory.
#
# Never reuse a key that has ever held anything on a mainnet.
BASE_SEPOLIA_KEY=
