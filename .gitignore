node_modules
.next
out
build
.DS_Store
*.pem
.env
.env*.local
.vercel
*.tsbuildinfo
next-env.d.ts
coverage

# Keel per-run gate result — machine-local, never committed.
.keel/gate-state.json

# Wrangler build/dry-run output
.wrangler/

# Operator export token — a secret, never committed.
.keel/export-token.txt

# Local Worker secrets for `wrangler dev`. Same shape as the deployed secrets,
# so this file is exactly the thing that must never be committed.
.dev.vars
**/.dev.vars

# Published from node_modules by scripts/copy-map-worker.mjs at build time.
public/maplibre/

# The downloaded car, and its conversion output.
#
# The source glb is tens of megabytes of somebody else's mesh and textures and
# has no business in a clone; `scripts/build-car.mjs` turns it into
# public/car/model3.bin, which is small enough to commit and is committed
# deliberately — see the README. This entry keeps the source out.
/assets/

# Testnet keys from scripts/chain. Worthless by construction — they hold play
# money on a network that resets — but a private key that reaches a working
# tree once will reach one again when it is not worthless, so the habit is the
# point.
scripts/chain/keys*.json
scripts/chain/*-result.json
scripts/chain/node_modules/

# The receiver's TLS material. The certificate is public but the key is not,
# and keeping the pair together is what makes it easy to place and hard to
# leak by halves.
deploy/fleet-telemetry/tls/
